    "<small>\n",
    "Obtenha o posto (ou rank) da matriz K. Use o método np.linalg.matrix_rank().\n",
    "<small>"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "679fe37d",
   "metadata": {},
   "outputs": [],
   "source": [
    "import numpy as np"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "a9b44480",
   "metadata": {},
   "outputs": [],
   "source": [
    "A = np.array([[2,-1,3],[1,4,2],[1,-5,1],[4,16,8]])\n",
    "A_posto = np.linalg.matrix_rank(A)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "81e1a4f4",
   "metadata": {},
   "outputs": [
