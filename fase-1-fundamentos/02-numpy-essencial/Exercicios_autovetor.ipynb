   "source": [
    "<small>\n",
    "Calcule os autovalores associadoas a matriz A. Utilize o método np.linalg.eigvals().\n",
    "<small>"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "678d78dc",
   "metadata": {},
   "outputs": [],
   "source": [
    "import numpy as np"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "978b2592",
   "metadata": {},
   "outputs": [],
   "source": [
    "A = np.array([[1,3],[-1,5]])"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "8894e4bf",
   "metadata": {},
   "outputs": [],
   "source": [
    "autovalores = np.linalg.eigvals(A)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "e396200a",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "[2. 4.]\n"
     ]
    }
   ],
   "source": [
    "print(autovalores)"
   ]
  },
